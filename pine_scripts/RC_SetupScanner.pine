// @version=5
// ─────────────────────────────────────────────────────────────────────────────
// RC Setup Scanner — Ross Cameron / Warrior Trading Style
// ─────────────────────────────────────────────────────────────────────────────
// Draws and tracks key intraday levels:
//   PDH / PDL  — Previous Day High / Low
//   PMH / PML  — Pre-Market High / Low (extended hours)
//   ORH / ORL  — Opening Range High / Low (configurable window)
//   VWAP       — Volume Weighted Average Price
//   9 EMA      — Short-term trend reference
//
// Status table (top-right) is readable by the trading-agents MCP watcher
// via data_get_pine_tables with study_filter="RC Setup Scanner".
//
// ALERT CONDITIONS — set in TradingView Alerts panel:
//   "ORB Breakout"  — price closes above ORH with high volume
//   "PMH Breakout"  — price closes above pre-market high
//   "PDH Breakout"  — price closes above previous day high
//   "VWAP Reclaim"  — price crosses back above VWAP with volume
//   "ORB Breakdown" — price closes below ORL with volume
// ─────────────────────────────────────────────────────────────────────────────

indicator("RC Setup Scanner", shorttitle="RC Scanner", overlay=true,
          max_lines_count=20, max_labels_count=50)

// ── Inputs ────────────────────────────────────────────────────────────────────
i_or_min    = input.int(5,    "Opening Range (minutes)",        minval=1,   maxval=30,  group="Settings")
i_vol_mult  = input.float(1.5,"High Volume Threshold (x avg)", minval=1.0, step=0.1,   group="Settings")
i_show_pd   = input.bool(true,"Show Previous Day Levels",                               group="Display")
i_show_pm   = input.bool(true,"Show Pre-Market Levels",                                 group="Display")
i_show_or   = input.bool(true,"Show Opening Range",                                     group="Display")
i_show_vwap = input.bool(true,"Show VWAP",                                              group="Display")
i_show_9e   = input.bool(true,"Show 9 EMA",                                             group="Display")

// ── Colors ────────────────────────────────────────────────────────────────────
c_pdh  = color.new(#FF4444, 0)
c_pdl  = color.new(#44FF44, 0)
c_pmh  = color.new(#FF9900, 0)
c_pml  = color.new(#00BBBB, 0)
c_orh  = color.new(#CC44FF, 0)
c_orl  = color.new(#4488FF, 0)
c_vwap = color.new(#FFEE00, 0)
c_ema9 = color.new(#FF8800, 0)

// ── Previous Day High / Low ───────────────────────────────────────────────────
pdh = request.security(syminfo.tickerid, "D", high[1])
pdl = request.security(syminfo.tickerid, "D", low[1])

// ── Pre-Market High / Low ─────────────────────────────────────────────────────
var float pmh_tracking = na
var float pml_tracking = na
var float pmh_final    = na
var float pml_final    = na

if session.isfirstbar_regular
    pmh_final    := na(pmh_tracking) ? open : pmh_tracking
    pml_final    := na(pml_tracking) ? open : pml_tracking
    pmh_tracking := na
    pml_tracking := na

if session.ispremarket
    pmh_tracking := na(pmh_tracking) ? high : math.max(pmh_tracking, high)
    pml_tracking := na(pml_tracking) ? low  : math.min(pml_tracking, low)

pmh = session.ispremarket ? pmh_tracking : pmh_final
pml = session.ispremarket ? pml_tracking : pml_final

// ── Opening Range ─────────────────────────────────────────────────────────────
var float orh       = na
var float orl       = na
var int   or_start  = 0
var bool  or_locked = false

if session.isfirstbar_regular
    or_start  := bar_index
    orh       := high
    orl       := low
    or_locked := false

if session.ismarket and not or_locked
    bars_in = bar_index - or_start
    if bars_in < i_or_min
        orh := math.max(orh, high)
        orl := math.min(orl, low)
    else
        or_locked := true

// ── VWAP + 9 EMA ─────────────────────────────────────────────────────────────
vwap_val = ta.vwap(hlc3)
ema9     = ta.ema(close, 9)

// ── Volume ────────────────────────────────────────────────────────────────────
vol_avg  = ta.sma(volume, 20)
high_vol = volume >= vol_avg * i_vol_mult
rel_vol  = vol_avg > 0 ? math.round(volume / vol_avg * 10) / 10 : 0.0

// ── Signal Detection ─────────────────────────────────────────────────────────
orb_breakout  = session.ismarket and or_locked and ta.crossover(close,  orh)      and high_vol
pmh_breakout  = session.ismarket and               ta.crossover(close,  pmh)      and high_vol
pdh_breakout  = session.ismarket and               ta.crossover(close,  pdh)      and high_vol
vwap_reclaim  = session.ismarket and               ta.crossover(close,  vwap_val) and high_vol
orb_breakdown = session.ismarket and or_locked and ta.crossunder(close, orl)      and high_vol

// ── Track Signals Fired Today ─────────────────────────────────────────────────
var bool fired_orb  = false
var bool fired_pmh  = false
var bool fired_pdh  = false
var bool fired_vwap = false
var bool fired_down = false

if session.isfirstbar_regular
    fired_orb  := false
    fired_pmh  := false
    fired_pdh  := false
    fired_vwap := false
    fired_down := false

if orb_breakout
    fired_orb := true
if pmh_breakout
    fired_pmh := true
if pdh_breakout
    fired_pdh := true
if vwap_reclaim
    fired_vwap := true
if orb_breakdown
    fired_down := true

// ── Signal Labels on Chart ────────────────────────────────────────────────────
if orb_breakout
    label.new(bar_index, low, "ORB\nBREAK", yloc=yloc.belowbar,
              style=label.style_label_up, color=c_orh, textcolor=color.white, size=size.small)
if pmh_breakout
    label.new(bar_index, low, "PMH\nBREAK", yloc=yloc.belowbar,
              style=label.style_label_up, color=c_pmh, textcolor=color.white, size=size.small)
if pdh_breakout
    label.new(bar_index, low, "PDH\nBREAK", yloc=yloc.belowbar,
              style=label.style_label_up, color=c_pdh, textcolor=color.white, size=size.small)
if vwap_reclaim
    label.new(bar_index, low, "VWAP\nRECLAIM", yloc=yloc.belowbar,
              style=label.style_label_up, color=c_vwap, textcolor=color.black, size=size.small)
if orb_breakdown
    label.new(bar_index, high, "ORB\nBREAKDN", yloc=yloc.abovebar,
              style=label.style_label_down, color=c_pdh, textcolor=color.white, size=size.small)

// ── Level Lines ───────────────────────────────────────────────────────────────
var line l_pdh = na
var line l_pdl = na
var line l_pmh = na
var line l_pml = na
var line l_orh = na
var line l_orl = na

f_line(ln, y, col, w, sty) =>
    if na(ln)
        line.new(bar_index - 100, y, bar_index, y, extend=extend.right, color=col, width=w, style=sty)
    else
        line.set_y1(ln, y)
        line.set_y2(ln, y)
        ln

if barstate.islast
    if i_show_pd and not na(pdh)
        l_pdh := f_line(l_pdh, pdh, c_pdh, 2, line.style_solid)
        l_pdl := f_line(l_pdl, pdl, c_pdl, 2, line.style_solid)
        label.new(bar_index + 2, pdh, "PDH " + str.tostring(pdh, "#.00"),
                  xloc=xloc.bar_index, style=label.style_label_left, color=c_pdh, textcolor=color.white, size=size.small)
        label.new(bar_index + 2, pdl, "PDL " + str.tostring(pdl, "#.00"),
                  xloc=xloc.bar_index, style=label.style_label_left, color=c_pdl, textcolor=color.white, size=size.small)
    if i_show_pm and not na(pmh)
        l_pmh := f_line(l_pmh, pmh, c_pmh, 1, line.style_dashed)
        l_pml := f_line(l_pml, pml, c_pml, 1, line.style_dashed)
        label.new(bar_index + 2, pmh, "PMH " + str.tostring(pmh, "#.00"),
                  xloc=xloc.bar_index, style=label.style_label_left, color=c_pmh, textcolor=color.white, size=size.small)
        label.new(bar_index + 2, pml, "PML " + str.tostring(pml, "#.00"),
                  xloc=xloc.bar_index, style=label.style_label_left, color=c_pml, textcolor=color.white, size=size.small)
    if i_show_or and not na(orh)
        l_orh := f_line(l_orh, orh, c_orh, 1, line.style_dotted)
        l_orl := f_line(l_orl, orl, c_orl, 1, line.style_dotted)
        label.new(bar_index + 2, orh, "ORH " + str.tostring(orh, "#.00"),
                  xloc=xloc.bar_index, style=label.style_label_left, color=c_orh, textcolor=color.white, size=size.small)
        label.new(bar_index + 2, orl, "ORL " + str.tostring(orl, "#.00"),
                  xloc=xloc.bar_index, style=label.style_label_left, color=c_orl, textcolor=color.white, size=size.small)

// ── VWAP + 9 EMA Plots ────────────────────────────────────────────────────────
plot(i_show_vwap ? vwap_val : na, "VWAP",  color=c_vwap, linewidth=2)
plot(i_show_9e   ? ema9     : na, "9 EMA", color=c_ema9,  linewidth=1)

// ── Helper Functions ─────────────────────────────────────────────────────────
f_above(price, level) =>
    na(level) ? "N/A" : price > level ? "ABOVE" : "BELOW"

f_val(v) =>
    na(v) ? "N/A" : str.tostring(v, "#.00")

f_stat_color(stat) =>
    if stat == "ABOVE"
        color.new(color.green, 55)
    else if stat == "BELOW"
        color.new(color.red, 65)
    else
        color.new(color.gray, 60)

// ── Status Table ─────────────────────────────────────────────────────────────
var table t = table.new(position.top_right, 3, 13,
                         bgcolor=color.new(color.black, 15),
                         border_color=color.new(color.gray, 40), border_width=1,
                         frame_color=color.new(color.gray, 20), frame_width=2)

if barstate.islast
    p = close

    hdr = color.new(#1a237e, 0)
    table.cell(t, 0, 0, "LEVEL",  text_color=color.white, bgcolor=hdr, text_size=size.small)
    table.cell(t, 1, 0, "VALUE",  text_color=color.white, bgcolor=hdr, text_size=size.small)
    table.cell(t, 2, 0, "STATUS", text_color=color.white, bgcolor=hdr, text_size=size.small)

    // Price + volume row
    vol_str = "RV " + str.tostring(rel_vol, "#.#") + "x" + (high_vol ? " HIGH" : "")
    table.cell(t, 0, 1, "PRICE",    text_color=color.white,                                     text_size=size.small)
    table.cell(t, 1, 1, f_val(p),   text_color=color.yellow,                                    text_size=size.small)
    table.cell(t, 2, 1, vol_str,    text_color=high_vol ? color.lime : color.silver,            text_size=size.small)

    // Level rows (one per key level)
    pdh_s = f_above(p, pdh)
    pdl_s = f_above(p, pdl)
    pmh_s = f_above(p, pmh)
    pml_s = f_above(p, pml)
    orh_s = f_above(p, orh)
    orl_s = f_above(p, orl)
    vwp_s = f_above(p, vwap_val)
    em9_s = f_above(p, ema9)

    table.cell(t, 0, 2, "PDH",      text_color=color.white,                      text_size=size.small)
    table.cell(t, 1, 2, f_val(pdh), text_color=color.white,                      text_size=size.small)
    table.cell(t, 2, 2, pdh_s,      text_color=color.white, bgcolor=f_stat_color(pdh_s), text_size=size.small)

    table.cell(t, 0, 3, "PDL",      text_color=color.white,                      text_size=size.small)
    table.cell(t, 1, 3, f_val(pdl), text_color=color.white,                      text_size=size.small)
    table.cell(t, 2, 3, pdl_s,      text_color=color.white, bgcolor=f_stat_color(pdl_s), text_size=size.small)

    table.cell(t, 0, 4, "PMH",      text_color=color.white,                      text_size=size.small)
    table.cell(t, 1, 4, f_val(pmh), text_color=color.white,                      text_size=size.small)
    table.cell(t, 2, 4, pmh_s,      text_color=color.white, bgcolor=f_stat_color(pmh_s), text_size=size.small)

    table.cell(t, 0, 5, "PML",      text_color=color.white,                      text_size=size.small)
    table.cell(t, 1, 5, f_val(pml), text_color=color.white,                      text_size=size.small)
    table.cell(t, 2, 5, pml_s,      text_color=color.white, bgcolor=f_stat_color(pml_s), text_size=size.small)

    table.cell(t, 0, 6, "ORH",      text_color=color.white,                      text_size=size.small)
    table.cell(t, 1, 6, f_val(orh), text_color=color.white,                      text_size=size.small)
    table.cell(t, 2, 6, orh_s,      text_color=color.white, bgcolor=f_stat_color(orh_s), text_size=size.small)

    table.cell(t, 0, 7, "ORL",      text_color=color.white,                      text_size=size.small)
    table.cell(t, 1, 7, f_val(orl), text_color=color.white,                      text_size=size.small)
    table.cell(t, 2, 7, orl_s,      text_color=color.white, bgcolor=f_stat_color(orl_s), text_size=size.small)

    table.cell(t, 0, 8, "VWAP",          text_color=color.white,                      text_size=size.small)
    table.cell(t, 1, 8, f_val(vwap_val), text_color=color.white,                      text_size=size.small)
    table.cell(t, 2, 8, vwp_s,           text_color=color.white, bgcolor=f_stat_color(vwp_s), text_size=size.small)

    table.cell(t, 0, 9, "9 EMA",    text_color=color.white,                      text_size=size.small)
    table.cell(t, 1, 9, f_val(ema9),text_color=color.white,                      text_size=size.small)
    table.cell(t, 2, 9, em9_s,      text_color=color.white, bgcolor=f_stat_color(em9_s), text_size=size.small)

    // Signals fired today
    sigs = ""
    if fired_orb
        sigs := sigs + "ORB "
    if fired_pmh
        sigs := sigs + "PMH "
    if fired_pdh
        sigs := sigs + "PDH "
    if fired_vwap
        sigs := sigs + "VWAP "
    if fired_down
        sigs := sigs + "BRKDN "
    sig_display = str.length(sigs) > 0 ? str.trim(sigs) : "NONE"

    // Bull level count and setup recommendation
    bull_count = (p > pdh ? 1 : 0) + (p > pmh ? 1 : 0) + (p > orh ? 1 : 0) + (p > vwap_val ? 1 : 0)

    setup = ""
    if bull_count >= 4 and fired_orb
        setup := "STRONG BUY"
    else if bull_count >= 3 and (fired_orb or fired_pmh)
        setup := "BUY SETUP"
    else if bull_count >= 2 and fired_vwap
        setup := "WATCH LONG"
    else if fired_down
        setup := "AVOID / SHORT"
    else if bull_count <= 1
        setup := "BEARISH"
    else
        setup := "NEUTRAL"

    setup_col = color.new(color.gray, 50)
    if str.contains(setup, "STRONG")
        setup_col := color.new(color.green, 10)
    else if str.contains(setup, "BUY")
        setup_col := color.new(color.green, 40)
    else if str.contains(setup, "WATCH")
        setup_col := color.new(color.orange, 40)
    else if str.contains(setup, "AVOID")
        setup_col := color.new(color.red, 30)

    table.cell(t, 0, 10, "SIGNALS",   text_color=color.white,                          text_size=size.small)
    table.cell(t, 1, 10, sig_display, text_color=color.yellow,                          text_size=size.small)
    table.cell(t, 2, 10, "",          text_color=color.white,                           text_size=size.small)

    table.cell(t, 0, 11, "SETUP",  text_color=color.white,                              text_size=size.small)
    table.cell(t, 1, 11, setup,    text_color=color.white, bgcolor=setup_col,           text_size=size.small)
    table.cell(t, 2, 11, str.tostring(bull_count) + "/4 bull", text_color=color.silver, text_size=size.small)

    table.cell(t, 0, 12, "OR",      text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 12, or_locked ? "LOCKED (" + str.tostring(i_or_min) + "m)" : "FORMING",
               text_color=or_locked ? color.lime : color.orange, text_size=size.tiny)
    table.cell(t, 2, 12, "", text_color=color.silver, text_size=size.tiny)

// ── Alert Conditions ──────────────────────────────────────────────────────────
alertcondition(orb_breakout,  title="ORB Breakout",  message="{{ticker}} ORB BREAKOUT above ORH — high volume")
alertcondition(pmh_breakout,  title="PMH Breakout",  message="{{ticker}} PRE-MARKET HIGH BREAKOUT")
alertcondition(pdh_breakout,  title="PDH Breakout",  message="{{ticker}} PREVIOUS DAY HIGH BREAKOUT")
alertcondition(vwap_reclaim,  title="VWAP Reclaim",  message="{{ticker}} VWAP RECLAIM with volume")
alertcondition(orb_breakdown, title="ORB Breakdown", message="{{ticker}} OPENING RANGE BREAKDOWN — exit longs")
